{
  "name": "Popup & Download Blocker",
  "version": "1.0",
  "manifest_version": 3,
  "description": "Block popup tabs and auto downloads",
  "permissions": [
    "tabs",
    "storage",
    "downloads",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
